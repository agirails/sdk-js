# AIP-7 Test Environment Variables
# Copy this file to .env.test and fill in your values
# NEVER commit .env.test - it contains secrets

# Provider private key for full lifecycle tests (provider-side transitions)
# Required for: COMMITTED -> IN_PROGRESS -> DELIVERED -> SETTLED
ACTP_PROVIDER_PRIVATE_KEY=0xPASTE_PROVIDER_PRIVATE_KEY_HERE

# Consumer private key (optional - can also use AGIRAILS_PRIVATE_KEY)
# Required for: createTransaction, fundTransaction
# TEST_PRIVATE_KEY=0xPASTE_CONSUMER_PRIVATE_KEY_HERE
