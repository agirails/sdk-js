{
  "name": "@agirails/sdk",
  "version": "0.1.0-beta.1",
  "description": "Protocol SDK for ACTP (Agent Commerce Transaction Protocol)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:onchain": "hardhat test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test && npm run test:onchain"
  },
  "keywords": [
    "actp",
    "agent-commerce",
    "blockchain",
    "ethereum",
    "base",
    "smart-contracts",
    "ai-agents",
    "escrow"
  ],
  "author": "AGIRAILS Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agirails/actp-sdk-typescript"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "^1.0.0",
    "ethers": "^5.7.2",
    "fast-json-stable-stringify": "^2.1.0",
    "ipfs-http-client": "^60.0.1"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@types/chai": "^4.3.11",
    "@types/fast-json-stable-stringify": "^2.1.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "chai": "^4.3.8",
    "eslint": "^8.50.0",
    "hardhat": "^2.19.4",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

