{
  "name": "@agirails/sdk",
  "version": "4.4.6",
  "description": "AGIRAILS SDK for the ACTP (Agent Commerce Transaction Protocol) - Unified mock + blockchain support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "require": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./negotiation": {
      "types": "./dist/negotiation/index.d.ts",
      "require": "./dist/negotiation/index.js",
      "default": "./dist/negotiation/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "require": "./dist/builders/index.js",
      "default": "./dist/builders/index.js"
    },
    "./transport": {
      "types": "./dist/transport/QuoteChannel.d.ts",
      "require": "./dist/transport/QuoteChannel.js",
      "default": "./dist/transport/QuoteChannel.js"
    }
  },
  "bin": {
    "actp": "./bin/actp",
    "agirails": "./bin/agirails"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:fork-e2e": "jest --runInBand --testPathPattern='src/__e2e__/blockchain-runtime/' --testTimeout=60000 --testPathIgnorePatterns=/node_modules/",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build && npm test && npm run lint",
    "test:all": "npm run test:setup && npm run test:happy-path && npm run test:dispute && npm run test:cancel",
    "eas:register": "ts-node scripts/register-eas-schema.ts",
    "eas:register:mainnet": "ts-node scripts/register-eas-schema.ts base-mainnet"
  },
  "keywords": [
    "agirails",
    "actp",
    "blockchain",
    "escrow",
    "payments",
    "ai-agents",
    "cli",
    "agent-commerce",
    "ethereum",
    "base",
    "smart-contracts"
  ],
  "author": "AGIRAILS Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agirails/sdk-js"
  },
  "bugs": {
    "url": "https://github.com/agirails/sdk-js/issues"
  },
  "homepage": "https://github.com/agirails/sdk-js#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@ethereum-attestation-service/eas-sdk": "^2.9.0",
    "@irys/sdk": "0.2.11",
    "@noble/curves": "^1.9.0",
    "@x402/core": "~2.9.0",
    "@x402/evm": "~2.9.0",
    "@x402/fetch": "~2.9.0",
    "commander": "11.1.0",
    "did-resolver": "4.1.0",
    "dotenv": "17.2.3",
    "ethers": "^6.15.0",
    "ethr-did-resolver": "11.0.5",
    "fast-json-stable-stringify": "2.1.0",
    "kubo-rpc-client": "6.1.0",
    "proper-lockfile": "4.1.2",
    "viem": "^2.47.12",
    "yaml": "^2.8.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.0.0",
    "@types/chai": "4.3.11",
    "@types/fast-json-stable-stringify": "2.1.0",
    "@types/jest": "29.5.11",
    "@types/mocha": "10.0.6",
    "@types/node": "20.10.0",
    "@types/proper-lockfile": "4.1.4",
    "@typescript-eslint/eslint-plugin": "6.0.0",
    "@typescript-eslint/parser": "6.0.0",
    "chai": "4.3.8",
    "eslint": "8.50.0",
    "hardhat": "2.19.4",
    "jest": "29.7.0",
    "prettier": "3.0.0",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.1",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "axios": "^1.15.0",
    "fast-xml-parser": "^5.3.5",
    "undici": "^6.25.0",
    "serialize-javascript": "^7.0.5",
    "mocha": "^11.0.0",
    "uuid": "^9.0.1"
  }
}
