{
  "name": "@agirails/sdk",
  "version": "2.5.6",
  "description": "AGIRAILS SDK for the ACTP (Agent Commerce Transaction Protocol) - Unified mock + blockchain support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "require": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    }
  },
  "bin": {
    "actp": "./bin/actp"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:onchain": "hardhat test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build && npm test && npm run lint",
    "test:setup": "ts-node test-scripts/00-setup.ts",
    "test:happy-path": "ts-node test-scripts/01-happy-path.ts",
    "test:dispute": "ts-node test-scripts/02-dispute.ts",
    "test:cancel": "ts-node test-scripts/03-cancel.ts",
    "test:happy-path-eas": "ts-node test-scripts/04-happy-path-eas.ts",
    "test:status": "ts-node test-scripts/status.ts",
    "test:all": "npm run test:setup && npm run test:happy-path && npm run test:dispute && npm run test:cancel",
    "eas:register": "ts-node scripts/register-eas-schema.ts",
    "eas:register:mainnet": "ts-node scripts/register-eas-schema.ts base-mainnet"
  },
  "keywords": [
    "agirails",
    "actp",
    "blockchain",
    "escrow",
    "payments",
    "ai-agents",
    "cli",
    "agent-commerce",
    "ethereum",
    "base",
    "smart-contracts"
  ],
  "author": "AGIRAILS Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agirails/sdk"
  },
  "bugs": {
    "url": "https://github.com/agirails/sdk/issues"
  },
  "homepage": "https://github.com/agirails/sdk#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.989.0",
    "@ethereum-attestation-service/eas-sdk": "1.6.1",
    "@irys/sdk": "0.2.11",
    "commander": "11.1.0",
    "did-resolver": "4.1.0",
    "dotenv": "17.2.3",
    "ethers": "6.15.0",
    "ethr-did-resolver": "11.0.5",
    "fast-json-stable-stringify": "2.1.0",
    "kubo-rpc-client": "6.1.0",
    "proper-lockfile": "4.1.2",
    "yaml": "^2.8.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.0.0",
    "@types/chai": "4.3.11",
    "@types/fast-json-stable-stringify": "2.1.0",
    "@types/jest": "29.5.11",
    "@types/mocha": "10.0.6",
    "@types/node": "20.10.0",
    "@types/proper-lockfile": "4.1.4",
    "@typescript-eslint/eslint-plugin": "6.0.0",
    "@typescript-eslint/parser": "6.0.0",
    "chai": "4.3.8",
    "eslint": "8.50.0",
    "hardhat": "2.19.4",
    "jest": "29.7.0",
    "prettier": "3.0.0",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.1",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
