#!/usr/bin/env python3
"""
code-check — the single entry point to the factory standard's check (rules: standard/STANDARD.md).

  code-check diff     [--repo DIR] [--base REF] [--staged] [--snapshot MANIFEST --base-dir DIR] [--json] [--only RULES]
  code-check full     [--repo DIR] [--json] [--baseline FILE [--base-baseline FILE]]
  code-check baseline --repo DIR --write FILE [--allow-increase --reason TEXT]

diff reports violations on new and changed lines and violations caused by deletion; full is a report (with --baseline
only what is above the baseline fails, and with --base-baseline also when the head baseline grows against the base);
baseline writes the current state, and growth needs --allow-increase and a reason.
Exit: 0 clean, 1 new violations (warnings do not fail), 2 not measured (never a pass).
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from factory.codecheck import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
