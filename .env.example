# Copy this file to .env and fill in your own values.
# Never commit .env — it is gitignored.

# ---- Test wallets (Base Sepolia only) --------------------------------
# Generated funded test wallets used by the e2e suite. NEVER use these on
# mainnet. Generate fresh keys with: openssl rand -hex 32
CLIENT_PRIVATE_KEY=0x...
PROVIDER_PRIVATE_KEY=0x...
ADMIN_PRIVATE_KEY=0x...

# ---- RPC endpoint ----------------------------------------------------
# Default: https://sepolia.base.org (rate-limited public RPC).
# Recommend Alchemy or QuickNode for any non-trivial usage.
RPC_URL=https://sepolia.base.org

# ---- Deployed contracts (Base Sepolia testnet) -----------------------
MOCK_USDC_ADDRESS=0x444b4e1A65949AB2ac75979D5d0166Eb7A248Ccb
EAS_DELIVERY_SCHEMA_UID=0x166501e7476e2fcf9214c4c5144533c2957d56fe59d639effc1719a0658d9c9a

# ---- Optional AA provider overrides ----------------------------------
# The SDK ships with shared CDP + Pimlico keys (paymaster-allowlisted to
# AgentRegistry + X402Relay only). Override here to route through your own
# account for billing isolation or higher rate limits.
CDP_API_KEY=
PIMLICO_API_KEY=

# ---- Receipts ---------------------------------------------------------
# Server URL for receipt uploads (default: https://agirails.app).
AGIRAILS_BASE_URL=

# Required for mock receipt uploads (mock auth uses API key, not signature).
AGIRAILS_API_KEY=
